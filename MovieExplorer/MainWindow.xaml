<Window x:Class="MovieExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MovieExplorer.Views"
        Title="영화 탐색 · MovieExplorer" Height="840" Width="1180" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#101217" Foreground="White"
        FontFamily="Malgun Gothic" Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Background" Value="#DDF66B"/>
            <Setter Property="Foreground" Value="#182008"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A3AAB9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>
    <Grid Margin="32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <TextBlock Text="M / MovieExplorer" FontSize="23" FontWeight="Bold" Foreground="#DDF66B"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button x:Name="BoxOfficeNavButton" Content="박스오피스" Click="ShowBoxOfficePage"
                        Foreground="#DDF66B" Style="{StaticResource NavigationButtonStyle}"/>
                <Button x:Name="UpcomingNavButton" Content="개봉 예정" Click="ShowUpcomingPage"
                        Style="{StaticResource NavigationButtonStyle}"/>
                <Button x:Name="PastNavButton" Content="지난 영화" Click="ShowPastPage"
                        Style="{StaticResource NavigationButtonStyle}"/>
                <Button x:Name="FavoritesNavButton" Content="관심 영화" Click="ShowFavoritesPage"
                        Style="{StaticResource NavigationButtonStyle}"/>
                <Button x:Name="AnalyticsNavButton" Content="통계" Click="ShowAnalyticsPage"
                        Style="{StaticResource NavigationButtonStyle}"/>
                <Button x:Name="DataSyncNavButton" Content="정보 관리" Click="ShowDataSyncPage"
                        Style="{StaticResource NavigationButtonStyle}"/>
            </StackPanel>
        </DockPanel>

        <StackPanel x:Name="BoxOfficeHeaderPanel" Grid.Row="1">
            <TextBlock x:Name="PageEyebrow" Text="DAILY BOX OFFICE IN KOREA" Foreground="#DDF66B" FontSize="12"/>
            <TextBlock x:Name="PageTitle" Text="국내 박스오피스" FontSize="30" FontWeight="Bold" Margin="0,8,0,10"/>
            <TextBlock x:Name="PageDescription" Text="선택한 날짜에 관객이 많이 찾은 영화와 상세 정보를 한눈에 확인해 보세요." Foreground="#A3AAB9"/>
            <Border Background="#1B1F28" CornerRadius="12" Padding="18" Margin="0,24,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="기준 날짜" Margin="0,0,0,8"/>
                        <DatePicker x:Name="BoxOfficeDatePicker" Padding="5" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="영화 제목 · 줄거리 검색" Margin="0,0,0,8"/>
                        <TextBox x:Name="SearchBox" Padding="10,8" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,16,0">
                        <TextBlock Text="장르" Margin="0,0,0,8"/>
                        <ComboBox x:Name="GenreBox" Padding="8" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,16,0">
                        <TextBlock Text="정렬" Margin="0,0,0,8"/>
                        <ComboBox x:Name="SortBox" Padding="8" FontSize="14"/>
                    </StackPanel>
                    <Button Grid.Column="4" Content="조회" Click="RefreshMovies" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
            <DockPanel Margin="0,0,0,16">
                <TextBlock Text="영화 둘러보기" FontSize="20" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock x:Name="SyncStatusLabel" Foreground="#A3AAB9" Margin="0,0,18,0"/>
                    <TextBlock x:Name="ResultLabel" Foreground="#A3AAB9"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <Grid x:Name="BoxOfficeContentPanel" Grid.Row="2">
            <ScrollViewer x:Name="BoxOfficeScrollViewer"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="MovieCards">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="238" Margin="0,0,18,22" Background="#1B1F28" CornerRadius="12">
                                <StackPanel>
                                    <Border Height="320" Background="#292F3A" CornerRadius="12,12,0,0">
                                        <Grid ClipToBounds="True">
                                            <TextBlock Text="포스터 없음" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8992A3"/>
                                            <Image Source="{Binding PosterUrl}" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Margin="16">
                                        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding BoxOfficeLabel}" Foreground="#DDF66B" FontWeight="Bold" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Metadata}" Foreground="#A3AAB9" FontSize="12" Margin="0,8,0,10" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Overview}" Height="42" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="#C2C7D1"/>
                                        <Button Content="영화 정보 보기  →" Margin="0,16,0,0" Click="ShowMovie" Tag="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel x:Name="StatusPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="StatusMessage" Text="영화 정보를 불러오는 중입니다…" TextAlignment="Center"
                           Foreground="#A3AAB9" FontSize="16" TextWrapping="Wrap" MaxWidth="620"/>
                <Button x:Name="RetryButton" Content="다시 시도" Click="RefreshMovies" Visibility="Collapsed"
                        HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="BoxOfficeFooter" Grid.Row="3" Text="영화 정보 제공: 영화진흥위원회·TMDB"
                   Foreground="#939CAB" FontSize="11" VerticalAlignment="Bottom"/>

        <views:UpcomingMoviesView x:Name="UpcomingPage" Grid.Row="1" Grid.RowSpan="3"
                                  Visibility="Collapsed"/>
        <views:PastMoviesView x:Name="PastPage" Grid.Row="1" Grid.RowSpan="3"
                              Visibility="Collapsed"/>
        <views:FavoriteMoviesView x:Name="FavoritesPage" Grid.Row="1" Grid.RowSpan="3"
                                  Visibility="Collapsed"/>
        <views:DataSyncDashboardView x:Name="DataSyncPage" Grid.Row="1" Grid.RowSpan="3"
                                     Visibility="Collapsed"/>
        <views:BoxOfficeAnalyticsView x:Name="AnalyticsPage" Grid.Row="1" Grid.RowSpan="3"
                                      Visibility="Collapsed"/>
        <views:MovieDetailView x:Name="MovieDetailPage" Grid.Row="1" Grid.RowSpan="3"
                               Visibility="Collapsed"/>
    </Grid>
</Window>
