<Window x:Class="MovieExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MovieExplorer"
        mc:Ignorable="d"
        Title="영화 탐색 · MovieExplorer" Height="840" Width="1180" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#101217" Foreground="White" FontFamily="Malgun Gothic">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="16,10"/>
            <Setter Property="Background" Value="#DDF66B"/><Setter Property="Foreground" Value="#182008"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="32,20">
        <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
        <DockPanel><TextBlock Text="M / MovieExplorer" FontSize="23" FontWeight="Bold" Foreground="#DDF66B"/><TextBlock Text="영화 탐색" HorizontalAlignment="Right" FontSize="14" Margin="0,8"/></DockPanel>
        <StackPanel Grid.Row="1">
            <TextBlock Text="YOUR NEXT MOVIE" Foreground="#DDF66B" FontSize="12"/>
            <TextBlock Text="오늘, 어떤 영화를 볼까요?" FontSize="30" FontWeight="Bold" Margin="0,8,0,10"/>
            <TextBlock Text="마음에 드는 이야기를 찾아보세요. 화면 시연을 위한 가상 영화 목록입니다." Foreground="#A3AAB9"/>
            <Border Background="#1B1F28" CornerRadius="12" Padding="18" Margin="0,24,0,20">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0"><TextBlock Text="영화 제목 · 줄거리 검색" Margin="0,0,0,8"/><TextBox x:Name="SearchBox" TextChanged="FilterChanged" Padding="10,8" FontSize="14" AutomationProperties.Name="영화 검색"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="장르" Margin="0,0,0,8"/><ComboBox x:Name="GenreBox" SelectionChanged="FilterChanged" Padding="8" FontSize="14" AutomationProperties.Name="장르 선택"/></StackPanel>
                    <Button Grid.Column="2" Content="초기화" Click="ResetFilters" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
            <DockPanel Margin="0,0,0,16"><TextBlock Text="영화 둘러보기" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="ResultLabel" HorizontalAlignment="Right" Foreground="#A3AAB9"/></DockPanel>
        </StackPanel>
        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="MovieCards">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Width="238" Margin="0,0,18,22" Background="#1B1F28" CornerRadius="12">
                            <StackPanel>
                                <Border Height="270" Background="{Binding PosterColor}" CornerRadius="12,12,0,0" Padding="20">
                                    <Grid ClipToBounds="True">
                                        <Ellipse Width="180" Height="180" Stroke="#55FFFFFF" StrokeThickness="1" Margin="100,20,-100,0"/>
                                        <StackPanel><TextBlock Text="MOVIEEXPLORER PREVIEW" FontSize="9" Foreground="#DDFFFFFF"/><TextBlock Text="{Binding Number}" FontSize="64" Foreground="#88FFFFFF" Margin="0,20,0,0"/></StackPanel>
                                        <StackPanel VerticalAlignment="Bottom"><TextBlock Text="{Binding EnglishTitle}" FontSize="10" Margin="0,0,0,8"/><TextBlock Text="{Binding Title}" FontSize="27" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock Text="가상 영화 · 샘플 포스터" FontSize="10" Margin="0,12,0,0" Foreground="#BBFFFFFF"/></StackPanel>
                                    </Grid>
                                </Border>
                                <StackPanel Margin="16">
                                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Metadata}" Foreground="#A3AAB9" FontSize="12" Margin="0,8,0,10"/>
                                    <TextBlock Text="{Binding Synopsis}" Height="42" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="#C2C7D1"/>
                                    <Button Content="영화 정보 보기  →" Margin="0,16,0,0" Click="ShowMovie" Tag="{Binding}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="EmptyMessage" Text="검색 결과가 없어요. 다른 검색어나 장르를 선택해 보세요." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A3AAB9" FontSize="16"/>
        </Grid>
        <TextBlock Grid.Row="3" Text="화면 미리보기 · 실제 영화 조회와 관심 영화 저장은 아직 연결되지 않았습니다." Foreground="#939CAB" FontSize="11" VerticalAlignment="Bottom"/>
    </Grid>
</Window>
