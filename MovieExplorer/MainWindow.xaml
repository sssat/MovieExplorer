<Window x:Class="MovieExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MovieExplorer.Views"
        Title="영화 탐색 · MovieExplorer" Height="840" Width="1180" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#101217" Foreground="White"
        FontFamily="Malgun Gothic">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Background" Value="#DDF66B"/>
            <Setter Property="Foreground" Value="#182008"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A3AAB9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="ActiveNavigationButtonStyle" TargetType="Button"
               BasedOn="{StaticResource NavigationButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Foreground" Value="#DDF66B"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <TextBlock Text="M / MovieExplorer" FontSize="23" FontWeight="Bold" Foreground="#DDF66B"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Content="박스오피스" Command="{Binding NavigateCommand}" CommandParameter="BoxOffice"
                        Tag="{Binding IsBoxOfficePage}" Style="{StaticResource ActiveNavigationButtonStyle}"/>
                <Button Content="개봉 예정" Command="{Binding NavigateCommand}" CommandParameter="Upcoming"
                        Tag="{Binding IsUpcomingPage}" Style="{StaticResource ActiveNavigationButtonStyle}"/>
                <Button Content="지난 영화" Command="{Binding NavigateCommand}" CommandParameter="Past"
                        Tag="{Binding IsPastPage}" Style="{StaticResource ActiveNavigationButtonStyle}"/>
                <Button Content="관심 영화" Command="{Binding NavigateCommand}" CommandParameter="Favorites"
                        Tag="{Binding IsFavoritesPage}" Style="{StaticResource ActiveNavigationButtonStyle}"/>
                <Button Content="통계" Command="{Binding NavigateCommand}" CommandParameter="Analytics"
                        Tag="{Binding IsAnalyticsPage}" Style="{StaticResource ActiveNavigationButtonStyle}"/>
                <Button Content="정보 관리" Command="{Binding NavigateCommand}" CommandParameter="DataStatus"
                        Tag="{Binding IsDataStatusPage}" Style="{StaticResource ActiveNavigationButtonStyle}"/>
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1" Visibility="{Binding IsBoxOfficePage, Converter={StaticResource BoolToVisibility}}">
            <TextBlock x:Name="PageEyebrow" Text="DAILY BOX OFFICE IN KOREA" Foreground="#DDF66B" FontSize="12"/>
            <TextBlock x:Name="PageTitle" Text="국내 박스오피스" FontSize="30" FontWeight="Bold" Margin="0,8,0,10"/>
            <TextBlock x:Name="PageDescription" Text="선택한 날짜에 관객이 많이 찾은 영화와 상세 정보를 한눈에 확인해 보세요." Foreground="#A3AAB9"/>
            <Border Background="#1B1F28" CornerRadius="12" Padding="18" Margin="0,24,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="기준 날짜" Margin="0,0,0,8"/>
                        <DatePicker SelectedDate="{Binding BoxOfficeDate, Mode=TwoWay}" Padding="5" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="영화 제목 · 줄거리 검색" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,16,0">
                        <TextBlock Text="장르" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding Genres}" SelectedItem="{Binding SelectedGenre, Mode=TwoWay}" Padding="8" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,16,0">
                        <TextBlock Text="정렬" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort, Mode=TwoWay}" Padding="8" FontSize="14"/>
                    </StackPanel>
                    <Button Grid.Column="4" Content="조회" Command="{Binding QueryBoxOfficeCommand}" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
            <DockPanel Margin="0,0,0,16">
                <TextBlock Text="영화 둘러보기" FontSize="20" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding SyncStatus}" Margin="0,0,18,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#A3AAB9"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SyncFailed}" Value="True">
                                        <Setter Property="Foreground" Value="#FF8F8F"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ResultLabel}" Foreground="#A3AAB9"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <Grid Grid.Row="2" Visibility="{Binding IsBoxOfficePage, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer x:Name="BoxOfficeScrollViewer"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding BoxOfficeMovies}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="238" Margin="0,0,18,22" Background="#1B1F28" CornerRadius="12">
                                <StackPanel>
                                    <Border Height="320" Background="#292F3A" CornerRadius="12,12,0,0">
                                        <Grid ClipToBounds="True">
                                            <TextBlock Text="포스터 없음" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8992A3"/>
                                            <Image Source="{Binding PosterUrl}" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Margin="16">
                                        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding BoxOfficeLabel}" Foreground="#DDF66B" FontWeight="Bold" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Metadata}" Foreground="#A3AAB9" FontSize="12" Margin="0,8,0,10" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Overview}" Height="42" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="#C2C7D1"/>
                                        <Button Content="영화 정보 보기  →" Margin="0,16,0,0"
                                                Command="{Binding DataContext.OpenMovieCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolToVisibility}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" ToolTip="{Binding StatusDetails}" TextAlignment="Center"
                           Foreground="#A3AAB9" FontSize="16" TextWrapping="Wrap" MaxWidth="620"/>
                <Button Content="다시 시도" Command="{Binding QueryBoxOfficeCommand}"
                        Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}"
                        HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="3" Text="영화 정보 제공: 영화진흥위원회·TMDB"
                   Visibility="{Binding IsBoxOfficePage, Converter={StaticResource BoolToVisibility}}"
                   Foreground="#939CAB" FontSize="11" VerticalAlignment="Bottom"/>

        <views:UpcomingMoviesView Grid.Row="1" Grid.RowSpan="3" DataContext="{Binding Upcoming}"
                                  Visibility="{Binding DataContext.IsUpcomingPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"/>
        <views:PastMoviesView Grid.Row="1" Grid.RowSpan="3" DataContext="{Binding Past}"
                              Visibility="{Binding DataContext.IsPastPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"/>
        <views:FavoriteMoviesView Grid.Row="1" Grid.RowSpan="3" DataContext="{Binding Favorites}"
                                  Visibility="{Binding DataContext.IsFavoritesPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"/>
        <views:DataSyncDashboardView Grid.Row="1" Grid.RowSpan="3" DataContext="{Binding DataStatus}"
                                     Visibility="{Binding DataContext.IsDataStatusPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"/>
        <views:BoxOfficeAnalyticsView Grid.Row="1" Grid.RowSpan="3" DataContext="{Binding Analytics}"
                                      Visibility="{Binding DataContext.IsAnalyticsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"/>
        <views:MovieDetailView Grid.Row="1" Grid.RowSpan="3" DataContext="{Binding Detail}"
                               Visibility="{Binding DataContext.IsDetailPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"/>
    </Grid>
</Window>
