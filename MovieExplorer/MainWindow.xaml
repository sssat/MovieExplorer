<Window x:Class="MovieExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="영화 탐색 · MovieExplorer" Height="840" Width="1180" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#101217" Foreground="White"
        FontFamily="Malgun Gothic" Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Background" Value="#DDF66B"/>
            <Setter Property="Foreground" Value="#182008"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <TextBlock Text="M / MovieExplorer" FontSize="23" FontWeight="Bold" Foreground="#DDF66B"/>
            <TextBlock Text="상영 중" HorizontalAlignment="Right" FontSize="14" Margin="0,8"/>
        </DockPanel>

        <StackPanel Grid.Row="1">
            <TextBlock x:Name="PageEyebrow" Text="DAILY BOX OFFICE IN KOREA" Foreground="#DDF66B" FontSize="12"/>
            <TextBlock x:Name="PageTitle" Text="국내 일별 박스오피스" FontSize="30" FontWeight="Bold" Margin="0,8,0,10"/>
            <TextBlock x:Name="PageDescription" Text="KOBIS 관객 수 순위와 TMDB 영화 정보를 함께 보여줍니다." Foreground="#A3AAB9"/>
            <Border Background="#1B1F28" CornerRadius="12" Padding="18" Margin="0,24,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="목록" Margin="0,0,0,8"/>
                        <ComboBox x:Name="SourceBox" SelectionChanged="SourceChanged" Padding="8" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="기준 날짜" Margin="0,0,0,8"/>
                        <DatePicker x:Name="BoxOfficeDatePicker" Padding="5" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,16,0">
                        <TextBlock Text="영화 제목 · 줄거리 검색" Margin="0,0,0,8"/>
                        <TextBox x:Name="SearchBox" TextChanged="FilterChanged" Padding="10,8" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,16,0">
                        <TextBlock Text="장르" Margin="0,0,0,8"/>
                        <ComboBox x:Name="GenreBox" SelectionChanged="FilterChanged" Padding="8" FontSize="14"/>
                    </StackPanel>
                    <Button Grid.Column="4" Content="초기화" Click="ResetFilters" VerticalAlignment="Bottom" Margin="0,0,10,0"/>
                    <Button Grid.Column="5" Content="조회" Click="RefreshMovies" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
            <DockPanel Margin="0,0,0,16">
                <TextBlock Text="영화 둘러보기" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="ResultLabel" HorizontalAlignment="Right" Foreground="#A3AAB9"/>
            </DockPanel>
        </StackPanel>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="MovieCards">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="238" Margin="0,0,18,22" Background="#1B1F28" CornerRadius="12">
                                <StackPanel>
                                    <Border Height="320" Background="#292F3A" CornerRadius="12,12,0,0">
                                        <Grid ClipToBounds="True">
                                            <TextBlock Text="포스터 없음" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8992A3"/>
                                            <Image Source="{Binding PosterUrl}" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Margin="16">
                                        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding BoxOfficeLabel}" Foreground="#DDF66B" FontWeight="Bold" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Metadata}" Foreground="#A3AAB9" FontSize="12" Margin="0,8,0,10" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Overview}" Height="42" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="#C2C7D1"/>
                                        <Button Content="영화 정보 보기  →" Margin="0,16,0,0" Click="ShowMovie" Tag="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel x:Name="StatusPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="StatusMessage" Text="영화 정보를 불러오는 중입니다…" TextAlignment="Center"
                           Foreground="#A3AAB9" FontSize="16" TextWrapping="Wrap" MaxWidth="620"/>
                <Button x:Name="RetryButton" Content="다시 시도" Click="RefreshMovies" Visibility="Collapsed"
                        HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="3" Text="박스오피스·관객 수는 KOBIS, 영화 정보·이미지·평점은 TMDB에서 제공합니다."
                   Foreground="#939CAB" FontSize="11" VerticalAlignment="Bottom"/>
    </Grid>
</Window>
