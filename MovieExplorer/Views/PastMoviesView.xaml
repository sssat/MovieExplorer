<UserControl x:Class="MovieExplorer.Views.PastMoviesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MovieExplorer.Views"
             Background="Transparent" Foreground="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="PAST RELEASES IN KOREA" Foreground="#DDF66B" FontSize="12"/>
            <TextBlock Text="지난 영화" FontSize="30" FontWeight="Bold" Margin="0,8,0,10"/>
            <TextBlock Text="선택 기간에 박스오피스에 진입한 지난 영화를 누적 관객 수 순으로 보여줍니다."
                       Foreground="#A3AAB9"/>

            <Border Background="#1B1F28" CornerRadius="12" Padding="18" Margin="0,24,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="135"/>
                        <ColumnDefinition Width="135"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="집계 시작일" Margin="0,0,0,8"/>
                        <DatePicker x:Name="FromDatePicker" Padding="5" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="집계 종료일" Margin="0,0,0,8"/>
                        <DatePicker x:Name="ToDatePicker" Padding="5" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="영화 제목 · 줄거리 검색" Margin="0,0,0,8"/>
                        <TextBox x:Name="SearchBox" Padding="10,8" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,12,0">
                        <TextBlock Text="장르" Margin="0,0,0,8"/>
                        <ComboBox x:Name="GenreBox" Padding="8" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Margin="0,0,12,0">
                        <TextBlock Text="정렬" Margin="0,0,0,8"/>
                        <ComboBox x:Name="SortBox" Padding="8" FontSize="13"/>
                    </StackPanel>
                    <Button Grid.Column="5" Content="조회" Click="RefreshMovies"
                            VerticalAlignment="Bottom"/>
                </Grid>
            </Border>

            <DockPanel Margin="0,0,0,16">
                <TextBlock Text="과거 개봉작 둘러보기" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="ResultLabel" HorizontalAlignment="Right" Foreground="#A3AAB9"/>
            </DockPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer x:Name="MovieScrollViewer" Grid.Row="0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="MovieCards">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="238" Margin="0,0,18,22" Background="#1B1F28" CornerRadius="12">
                                <StackPanel>
                                    <Border Height="320" Background="#292F3A" CornerRadius="12,12,0,0">
                                        <Grid ClipToBounds="True">
                                            <TextBlock Text="포스터 없음" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Foreground="#8992A3"/>
                                            <Image Source="{Binding PosterUrl}" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Margin="16">
                                        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding BoxOfficeLabel}" Foreground="#DDF66B"
                                                   FontWeight="Bold" FontSize="12" Margin="0,8,0,0"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Metadata}" Foreground="#A3AAB9" FontSize="12"
                                                   Margin="0,8,0,10" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Overview}" Height="42" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" FontSize="12" Foreground="#C2C7D1"/>
                                        <Button Content="영화 정보 보기  →" Margin="0,16,0,0"
                                                Click="ShowMovie" Tag="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel x:Name="StatusPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="StatusMessage" Text="지난 영화를 불러오는 중입니다…"
                           TextAlignment="Center" Foreground="#A3AAB9" FontSize="16"
                           TextWrapping="Wrap" MaxWidth="620"/>
                <Button x:Name="RetryButton" Content="다시 시도" Click="RefreshMovies"
                        Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
            <local:PaginationControl x:Name="Pagination" Grid.Row="1"/>
        </Grid>

        <TextBlock Grid.Row="2" Text="순위·관객 수는 KOBIS, 포스터·줄거리·평점은 TMDB에서 제공합니다."
                   Foreground="#939CAB" FontSize="11" VerticalAlignment="Bottom"/>
    </Grid>
</UserControl>
