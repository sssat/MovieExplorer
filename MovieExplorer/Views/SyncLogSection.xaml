<UserControl x:Class="MovieExplorer.Views.SyncLogSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MovieExplorer.Views"
             Background="Transparent" Foreground="White">
    <Border Background="#1B1F28" CornerRadius="12" Padding="18" Margin="0,0,0,14">
        <StackPanel>
            <DockPanel Margin="0,0,0,4">
                <TextBlock x:Name="TitleLabel" FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="CountLabel" DockPanel.Dock="Right"
                           HorizontalAlignment="Right" Foreground="#A3AAB9"/>
            </DockPanel>
            <TextBlock x:Name="DescriptionLabel" Foreground="#8992A3"
                       FontSize="11" Margin="0,0,0,14"/>
            <Grid Margin="8,0,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="0.6*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1.9*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="기준 날짜" Foreground="#A3AAB9"/>
                <TextBlock Grid.Column="1" Text="시작 시간" Foreground="#A3AAB9"/>
                <TextBlock Grid.Column="2" Text="상태" Foreground="#A3AAB9"/>
                <TextBlock Grid.Column="3" Text="처리 결과" Foreground="#A3AAB9"/>
                <TextBlock Grid.Column="4" Text="오류 내용" Foreground="#A3AAB9"/>
            </Grid>
            <ItemsControl x:Name="LogRows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#303642" BorderThickness="0,1,0,0" Padding="8,11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.9*"/>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="0.6*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.9*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TargetDateLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding StartedAtLabel}"/>
                                <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#DDF66B"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                    <Setter Property="Foreground" Value="#FF8F8F"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Running">
                                                    <Setter Property="Foreground" Value="#FFD36B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="3" Text="{Binding ResultLabel}"/>
                                <TextBlock Grid.Column="4" Text="{Binding ErrorLabel}" Foreground="#A3AAB9"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ErrorLabel}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="EmptyLabel" Text="아직 저장된 동기화 기록이 없습니다."
                       Foreground="#8992A3" HorizontalAlignment="Center" Margin="0,14,0,2"
                       Visibility="Collapsed"/>
            <local:PaginationControl x:Name="Pagination"/>
        </StackPanel>
    </Border>
</UserControl>
