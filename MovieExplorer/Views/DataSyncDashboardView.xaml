<UserControl x:Class="MovieExplorer.Views.DataSyncDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MovieExplorer.Views"
             Background="Transparent" Foreground="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,10,24">
            <TextBlock Text="DATA SYNC MANAGEMENT" Foreground="#DDF66B" FontSize="12"/>
            <TextBlock Text="데이터 동기화 관리" FontSize="30" FontWeight="Bold" Margin="0,8,0,10"/>
            <TextBlock Text="외부 API에서 수집해 MSSQL에 저장한 영화 데이터의 상태와 동기화 이력을 확인합니다."
                       Foreground="#A3AAB9"/>

            <Border Background="#1B1F28" CornerRadius="12" Padding="18" Margin="0,24,0,20">
                <DockPanel>
                    <StackPanel>
                        <TextBlock Text="연결된 데이터베이스" Foreground="#8992A3" FontSize="11"/>
                        <TextBlock x:Name="ConnectionLabel" FontSize="16" FontWeight="Bold" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="RefreshedAtLabel" Foreground="#A3AAB9"
                                   VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button x:Name="RefreshButton" Content="현황 새로고침" Click="RefreshDashboard"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel x:Name="StatusPanel" HorizontalAlignment="Center" Margin="0,70,0,0">
                <TextBlock x:Name="StatusMessage" Text="저장된 데이터 현황을 확인하고 있어요…"
                           TextAlignment="Center" Foreground="#A3AAB9" FontSize="15"
                           TextWrapping="Wrap" MaxWidth="700"/>
                <Button x:Name="RetryButton" Content="다시 시도" Click="RefreshDashboard"
                        Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>

            <StackPanel x:Name="DashboardPanel" Visibility="Collapsed">
                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <Border Background="#1B1F28" CornerRadius="12" Padding="18" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="저장된 영화" Foreground="#A3AAB9"/>
                            <TextBlock x:Name="MovieCountLabel" FontSize="23" FontWeight="Bold"
                                       Foreground="#DDF66B" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1B1F28" CornerRadius="12" Padding="18" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="관심 영화" Foreground="#A3AAB9"/>
                            <TextBlock x:Name="FavoriteCountLabel" FontSize="23" FontWeight="Bold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1B1F28" CornerRadius="12" Padding="18" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="포스터 정보 없음" Foreground="#A3AAB9"/>
                            <TextBlock x:Name="MissingPosterCountLabel" FontSize="23" FontWeight="Bold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1B1F28" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <TextBlock Text="TMDB 연결 없음" Foreground="#A3AAB9"/>
                            <TextBlock x:Name="MissingTmdbCountLabel" FontSize="23" FontWeight="Bold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Background="#1B1F28" CornerRadius="12" Padding="18" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="데이터 보유 현황" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="화면별로 저장된 레코드와 조회 가능한 기간입니다."
                                   Foreground="#8992A3" FontSize="11" Margin="0,4,0,14"/>
                        <Grid Margin="8,0,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1.8*"/>
                                <ColumnDefinition Width="0.7*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="구분" Foreground="#A3AAB9"/>
                            <TextBlock Grid.Column="1" Text="용도" Foreground="#A3AAB9"/>
                            <TextBlock Grid.Column="2" Text="저장 건수" Foreground="#A3AAB9"/>
                            <TextBlock Grid.Column="3" Text="수집 기준 수" Foreground="#A3AAB9"/>
                            <TextBlock Grid.Column="4" Text="데이터 기간" Foreground="#A3AAB9"/>
                            <TextBlock Grid.Column="5" Text="마지막 갱신" Foreground="#A3AAB9"/>
                        </Grid>
                        <ItemsControl x:Name="DataSetRows">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#303642" BorderThickness="0,1,0,0" Padding="8,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.1*"/>
                                                <ColumnDefinition Width="1.8*"/>
                                                <ColumnDefinition Width="0.7*"/>
                                                <ColumnDefinition Width="0.8*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="#A3AAB9"
                                                       TextWrapping="Wrap" Margin="0,0,12,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding RecordCountLabel}" Foreground="#DDF66B"/>
                                            <TextBlock Grid.Column="3" Text="{Binding SnapshotCountLabel}"/>
                                            <TextBlock Grid.Column="4" Text="{Binding CoverageLabel}"/>
                                            <TextBlock Grid.Column="5" Text="{Binding LastUpdatedLabel}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="최근 동기화 기록" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="각 화면의 동기화 기록을 최신순으로 10건씩 확인합니다."
                           Foreground="#8992A3" FontSize="11" Margin="0,0,0,12"/>
                <local:SyncLogSection x:Name="BoxOfficeLogSection"/>
                <local:SyncLogSection x:Name="UpcomingLogSection"/>
                <local:SyncLogSection x:Name="PastLogSection"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
