<UserControl x:Class="MovieExplorer.Views.DataSyncDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MovieExplorer.Views"
             Background="Transparent" Foreground="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,10,24">
            <TextBlock Text="MOVIE DATA STATUS" Foreground="#DDF66B" FontSize="12"/>
            <TextBlock Text="영화 정보 관리" FontSize="30" FontWeight="Bold" Margin="0,8,0,10"/>
            <TextBlock Text="영화 정보가 언제, 얼마나 업데이트되었는지 한눈에 확인합니다."
                       Foreground="#A3AAB9"/>

            <Border Background="#1B1F28" CornerRadius="12" Padding="18" Margin="0,24,0,20">
                <DockPanel>
                    <StackPanel>
                        <TextBlock Text="영화 정보 현황" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="최근 반영된 영화 정보와 업데이트 내역을 확인해 보세요."
                                   Foreground="#8992A3" FontSize="11" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding RefreshedAtLabel}" Foreground="#A3AAB9"
                                   VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button Content="새로고침" Command="{Binding RefreshCommand}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolToVisibility}}"
                        HorizontalAlignment="Center" Margin="0,70,0,0">
                <TextBlock Text="{Binding StatusMessage}" ToolTip="{Binding StatusDetails}"
                           TextAlignment="Center" Foreground="#A3AAB9" FontSize="15"
                           TextWrapping="Wrap" MaxWidth="700"/>
                <Button Content="다시 시도" Command="{Binding RefreshCommand}"
                        Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}"
                        HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>

            <StackPanel Visibility="{Binding IsDashboardVisible, Converter={StaticResource BoolToVisibility}}">
                <UniformGrid Columns="3" Margin="0,0,0,20">
                    <Border Background="#1B1F28" CornerRadius="12" Padding="18" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="보유 영화" Foreground="#A3AAB9"/>
                            <TextBlock Text="{Binding MovieCountLabel}" FontSize="23" FontWeight="Bold"
                                       Foreground="#DDF66B" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1B1F28" CornerRadius="12" Padding="18" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="포스터 정보 없음" Foreground="#A3AAB9"/>
                            <TextBlock Text="{Binding MissingPosterCountLabel}" FontSize="23" FontWeight="Bold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1B1F28" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <TextBlock Text="상세 정보 미등록" Foreground="#A3AAB9"/>
                            <TextBlock Text="{Binding MissingTmdbCountLabel}" FontSize="23" FontWeight="Bold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Background="#1B1F28" CornerRadius="12" Padding="18" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="영화 정보 현황" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="화면별로 보유한 영화 정보와 확인 가능한 기간입니다."
                                   Foreground="#8992A3" FontSize="11" Margin="0,4,0,14"/>
                        <Grid Margin="8,0,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="0.7*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="구분" Foreground="#A3AAB9"/>
                            <TextBlock Grid.Column="1" Text="영화 수" Foreground="#A3AAB9"/>
                            <TextBlock Grid.Column="2" Text="확인 날짜" Foreground="#A3AAB9"/>
                            <TextBlock Grid.Column="3" Text="확인 가능 기간" Foreground="#A3AAB9"/>
                            <TextBlock Grid.Column="4" Text="최근 업데이트" Foreground="#A3AAB9"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding DataSets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#303642" BorderThickness="0,1,0,0" Padding="8,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.1*"/>
                                                <ColumnDefinition Width="0.7*"/>
                                                <ColumnDefinition Width="0.8*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding MovieCountLabel}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding SnapshotCountLabel}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding CoverageLabel}"/>
                                            <TextBlock Grid.Column="4" Text="{Binding LastUpdatedLabel}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="최근 업데이트 내역" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="각 화면의 업데이트 내역을 최신순으로 10건씩 확인합니다."
                           Foreground="#8992A3" FontSize="11" Margin="0,0,0,12"/>
                <local:SyncLogSection DataContext="{Binding BoxOfficeLogs}"/>
                <local:SyncLogSection DataContext="{Binding UpcomingLogs}"/>
                <local:SyncLogSection DataContext="{Binding PastLogs}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
