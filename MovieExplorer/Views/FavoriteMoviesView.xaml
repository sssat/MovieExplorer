<UserControl x:Class="MovieExplorer.Views.FavoriteMoviesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MovieExplorer.Views"
             Background="Transparent" Foreground="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="MY FAVORITE MOVIES" Foreground="#DDF66B" FontSize="12"/>
            <TextBlock Text="관심 영화" FontSize="30" FontWeight="Bold" Margin="0,8,0,10"/>
            <TextBlock Text="관심 영화로 저장한 작품과 나의 평점·감상평을 모아봅니다."
                       Foreground="#A3AAB9"/>

            <Border Background="#1B1F28" CornerRadius="12" Padding="18" Margin="0,24,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="영화 제목 · 감상평 검색" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="개인 평점" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding RatingOptions}" SelectedItem="{Binding SelectedRating, Mode=TwoWay}" Padding="8" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,16,0">
                        <TextBlock Text="정렬" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort, Mode=TwoWay}" Padding="8" FontSize="14"/>
                    </StackPanel>
                    <Button Grid.Column="3" Content="조회" Command="{Binding QueryCommand}"
                            VerticalAlignment="Bottom"/>
                </Grid>
            </Border>

            <DockPanel Margin="0,0,0,16">
                <TextBlock Text="내가 저장한 영화" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="{Binding ResultLabel}" HorizontalAlignment="Right" Foreground="#A3AAB9"/>
            </DockPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer x:Name="MovieScrollViewer" Grid.Row="0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="238" Margin="0,0,18,22" Background="#1B1F28" CornerRadius="12">
                                <StackPanel>
                                    <Border Height="300" Background="#292F3A" CornerRadius="12,12,0,0">
                                        <Grid ClipToBounds="True">
                                            <TextBlock Text="포스터 없음" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Foreground="#8992A3"/>
                                            <Image Source="{Binding Movie.PosterUrl}" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Margin="16">
                                        <TextBlock Text="{Binding Movie.Title}" FontSize="18" FontWeight="Bold"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding RatingLabel}" Foreground="#DDF66B"
                                                   FontWeight="Bold" FontSize="12" Margin="0,8,0,0"/>
                                        <TextBlock Text="{Binding Movie.ReleaseDate}" Foreground="#A3AAB9"
                                                   FontSize="12" Margin="0,6,0,10"/>
                                        <TextBlock Text="{Binding ReviewLabel}" Height="42" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" FontSize="12" Foreground="#C2C7D1"/>
                                        <TextBlock Text="{Binding UpdatedAtLabel}" Foreground="#7F8899"
                                                   FontSize="11" Margin="0,8,0,0"/>
                                        <Button Content="영화 정보 보기  →" Margin="0,14,0,0"
                                                Command="{Binding DataContext.OpenMovieCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Movie}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolToVisibility}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" ToolTip="{Binding StatusDetails}"
                           TextAlignment="Center" Foreground="#A3AAB9" FontSize="16"
                           TextWrapping="Wrap" MaxWidth="620"/>
                <Button Content="다시 시도" Command="{Binding RefreshCommand}"
                        Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}"
                        HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
            <local:PaginationControl x:Name="Pagination" Grid.Row="1"
                                     CurrentPage="{Binding CurrentPage, Mode=TwoWay}"
                                     TotalItemCount="{Binding TotalItemCount}"
                                     PageSize="{Binding ItemsPerPage}"
                                     PageChangedCommand="{Binding ChangePageCommand}"/>
        </Grid>

        <TextBlock Grid.Row="2" Text="관심 영화와 나의 평점·감상평은 저장 후 언제든 다시 확인할 수 있습니다."
                   Foreground="#939CAB" FontSize="11" VerticalAlignment="Bottom"/>
    </Grid>
</UserControl>
